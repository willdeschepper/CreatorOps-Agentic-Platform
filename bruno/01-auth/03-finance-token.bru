meta {
  name: Authenticate finance
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/auth/token
  body: json
  auth: none
}

body:json {
  {
    "email": "{{finance_email}}",
    "password": "{{password}}",
    "brand_slug": "{{brand_slug}}"
  }
}

script:post-response {
  bru.setEnvVar("finance_token", res.body.access_token);
}

tests {
  test("Finance receives a bearer token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.token_type).to.equal("bearer");
  });
}
