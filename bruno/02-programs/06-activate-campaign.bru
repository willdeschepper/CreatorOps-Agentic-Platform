meta {
  name: Activate campaign
  type: http
  seq: 6
}

post {
  url: {{base_url}}/v1/campaigns/{{campaign_id}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{owner_token}}
}

body:json {
  {
    "status": "active"
  }
}

tests {
  test("Campaign becomes active", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("active");
  });
}
