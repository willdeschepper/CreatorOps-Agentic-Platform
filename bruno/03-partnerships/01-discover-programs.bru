meta {
  name: Creator discovers active programs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v1/programs
  body: none
  auth: bearer
}

auth:bearer {
  token: {{creator_a_token}}
}

tests {
  test("Creator can discover the active program", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items.some((program) => program.id === bru.getEnvVar("program_id"))).to.equal(true);
  });
}
