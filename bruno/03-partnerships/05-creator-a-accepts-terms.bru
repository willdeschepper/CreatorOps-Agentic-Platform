meta {
  name: Creator A accepts current terms
  type: http
  seq: 5
}

post {
  url: {{base_url}}/v1/memberships/{{membership_a_id}}/terms-acceptances
  body: json
  auth: bearer
}

auth:bearer {
  token: {{creator_a_token}}
}

body:json {
  {
    "terms_id": "{{terms_id}}"
  }
}

script:post-response {
  const coupon = res.body.assets.find((asset) => asset.asset_type === "coupon");
  const link = res.body.assets.find((asset) => asset.asset_type === "link");
  bru.setEnvVar("coupon_a_code", coupon.code);
  bru.setEnvVar("link_a_code", link.code);
}

tests {
  test("Terms activate the membership and generate both assets", function () {
    expect(res.status).to.equal(200);
    expect(res.body.membership.status).to.equal("active");
    expect(res.body.assets.some((asset) => asset.asset_type === "coupon")).to.equal(true);
    expect(res.body.assets.some((asset) => asset.asset_type === "link")).to.equal(true);
  });
}
