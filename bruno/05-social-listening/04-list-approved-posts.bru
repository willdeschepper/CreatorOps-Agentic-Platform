meta {
  name: List approved posts
  type: http
  seq: 5
}

get {
  url: {{base_url}}/v1/posts?content_status=approved
  body: none
  auth: bearer
}

auth:bearer {
  token: {{owner_token}}
}

tests {
  test("Approved post is visible in tenant queue", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items.some((item) => item.id === bru.getEnvVar("content_id"))).to.equal(true);
  });
}
