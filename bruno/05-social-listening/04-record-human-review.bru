meta {
  name: Record human review metadata
  type: http
  seq: 4
}

get {
  url: {{base_url}}/v1/posts/{{content_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ops_token}}
}

script:post-response {
  bru.setEnvVar("content_reviewer", res.body.reviewed_by);
  bru.setEnvVar("content_reviewed_at", res.body.reviewed_at);
}

tests {
  test("The approval has a recorded human reviewer", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("approved");
    expect(res.body.reviewed_by).to.be.a("string");
    expect(res.body.reviewed_at).to.be.a("string");
  });
}
