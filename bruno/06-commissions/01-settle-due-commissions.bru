meta {
  name: Settle due commissions
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/commissions/settle
  body: json
  auth: bearer
}

auth:bearer {
  token: {{finance_token}}
}

body:json {
  {
    "as_of": "{{settlement_at}}"
  }
}

tests {
  test("Sale and bonus move from pending to available", function () {
    expect(res.status).to.equal(200);
    expect(res.body.settled).to.equal(2);
  });
}
