meta {
  name: Creator A inspects available balance
  type: http
  seq: 2
}

get {
  url: {{base_url}}/v1/memberships/{{membership_a_id}}/balance
  body: none
  auth: bearer
}

auth:bearer {
  token: {{creator_a_token}}
}

tests {
  test("Ledger exposes exactly 29 BRL as available", function () {
    expect(res.status).to.equal(200);
    expect(res.body.pending).to.equal("0.00");
    expect(res.body.available).to.equal("29.00");
    expect(res.body.reserved).to.equal("0.00");
  });
}
