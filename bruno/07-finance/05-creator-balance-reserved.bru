meta {
  name: Creator sees reserved balance while payout is unknown
  type: http
  seq: 5
}

get {
  url: {{base_url}}/v1/memberships/{{membership_a_id}}/balance
  body: none
  auth: bearer
}

auth:bearer {
  token: {{creator_a_token}}
}

tests {
  test("Unknown payout keeps the reserve intact", function () {
    expect(res.status).to.equal(200);
    expect(res.body.available).to.equal("0.00");
    expect(res.body.reserved).to.equal("29.00");
    expect(res.body.paid).to.equal("0.00");
  });
}
