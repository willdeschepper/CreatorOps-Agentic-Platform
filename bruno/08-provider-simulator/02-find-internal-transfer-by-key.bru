meta {
  name: Find timed-out transfer by preserved key
  type: http
  seq: 2
}

get {
  url: {{provider_url}}/transfers/by-key/creatorops:{{payout_batch_id}}:{{membership_a_id}}
  body: none
  auth: none
}

tests {
  test("Provider confirms the transfer that is internally unknown", function () {
    expect(res.status).to.equal(200);
    expect(res.body.payout_id).to.equal(bru.getEnvVar("payout_id"));
    expect(res.body.status).to.equal("confirmed");
    expect(res.body.amount).to.equal("29.00");
  });
}
