meta {
  name: Replay isolated provider transfer
  type: http
  seq: 5
}

post {
  url: {{provider_url}}/transfers
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{provider_test_key}}
}

body:json {
  {
    "payout_id": "{{provider_test_payout_id}}",
    "beneficiary_id": "{{provider_test_beneficiary_id}}",
    "amount": "10.00",
    "currency": "BRL",
    "scenario": "success"
  }
}

tests {
  test("Same provider key and payload returns the same transfer", function () {
    expect(res.status).to.equal(200);
    expect(res.body.idempotency_key).to.equal(bru.getEnvVar("provider_test_key"));
    expect(res.body.payout_id).to.equal(bru.getEnvVar("provider_test_payout_id"));
  });
}
