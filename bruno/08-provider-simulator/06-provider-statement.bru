meta {
  name: Inspect complete provider statement
  type: http
  seq: 6
}

get {
  url: {{provider_url}}/statement
  body: none
  auth: none
}

tests {
  test("Statement is an append-only list of transfers", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
    expect(res.body.some((transfer) => transfer.payout_id === bru.getEnvVar("payout_id"))).to.equal(true);
  });
}
