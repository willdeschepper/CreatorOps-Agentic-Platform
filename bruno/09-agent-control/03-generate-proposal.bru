meta {
  name: Generate deterministic proposal
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/agent/findings/{{finding_id}}/proposals
  body: none
  auth: bearer
}

auth:bearer {
  token: {{finance_token}}
}

script:post-response {
  bru.setEnvVar("proposal_id", res.body.id);
}

tests {
  test("Agent only proposes confirming the existing transfer", function () {
    expect(res.status).to.equal(201);
    expect(res.body.action).to.equal("confirm_payout");
    expect(res.body.state).to.equal("draft");
    expect(res.body.proposed_changes.append_only).to.equal(true);
  });
}
