meta {
  name: Block execution without human approval
  type: http
  seq: 5
}

post {
  url: {{base_url}}/v1/agent/proposals/{{proposal_id}}/execute
  body: none
  auth: bearer
}

auth:bearer {
  token: {{finance_token}}
}

tests {
  test("Passing gates alone cannot execute money changes", function () {
    expect(res.status).to.equal(409);
    expect(res.body.code).to.equal("human_approval_required");
  });
}
