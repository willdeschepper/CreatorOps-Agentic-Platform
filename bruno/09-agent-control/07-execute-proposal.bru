meta {
  name: Execute approved proposal
  type: http
  seq: 7
}

post {
  url: {{base_url}}/v1/agent/proposals/{{proposal_id}}/execute
  body: none
  auth: bearer
}

auth:bearer {
  token: {{finance_token}}
}

tests {
  test("Executor revalidates and applies the correction", function () {
    expect(res.status).to.equal(200);
    expect(res.body.state).to.equal("executed");
  });
}
