meta {
  name: List resolved findings
  type: http
  seq: 9
}

get {
  url: {{base_url}}/v1/agent/findings?finding_state=resolved
  body: none
  auth: bearer
}

auth:bearer {
  token: {{finance_token}}
}

tests {
  test("Original finding is resolved but remains auditable", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items.some((finding) => finding.id === bru.getEnvVar("finding_id"))).to.equal(true);
  });
}
