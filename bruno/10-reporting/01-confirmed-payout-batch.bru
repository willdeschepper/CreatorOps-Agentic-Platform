meta {
  name: Inspect reconciled payout batch
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v1/payout-batches/{{payout_batch_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{finance_token}}
}

tests {
  test("Reconciliation confirms the payout without another transfer", function () {
    expect(res.status).to.equal(200);
    expect(res.body.payouts[0].status).to.equal("confirmed");
    expect(res.body.payouts[0].provider_reference).to.be.a("string");
  });
}
