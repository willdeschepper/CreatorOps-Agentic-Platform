meta {
  name: Prevent ops from creating financial rules
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/programs/{{program_id}}/commission-plans
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ops_token}}
}

body:json {
  {
    "campaign_id": null,
    "base_rate": "0.01",
    "return_window_days": 7,
    "payout_minimum": "100.00",
    "active_from": "{{commission_active_from}}",
    "tiers": [],
    "bonuses": []
  }
}

tests {
  test("Only finance or owner may create commission plans", function () {
    expect(res.status).to.equal(403);
    expect(res.body.code).to.equal("forbidden");
  });
}
