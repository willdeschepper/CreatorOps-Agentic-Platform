meta {
  name: Reject same event id with different payload
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/webhooks/commerce/{{brand_slug}}
  body: text
  auth: none
}

headers {
  Content-Type: application/json
}

body:text {
  {}
}

script:pre-request {
  const crypto = require("crypto-js");
  const raw = JSON.stringify({
    event_id: bru.getEnvVar("commerce_event_id"),
    event_type: "order.paid",
    order_id: bru.getEnvVar("external_order_id"),
    occurred_at: bru.getEnvVar("commerce_occurred_at"),
    amount: "201.00",
    currency: "BRL",
    coupon_code: bru.getEnvVar("coupon_a_code"),
    click_id: bru.getEnvVar("click_id")
  });
  const digest = crypto.HmacSHA256(raw, bru.getEnvVar("webhook_secret")).toString(crypto.enc.Hex);
  req.setBody(raw);
  req.setHeader("X-Webhook-Signature", `sha256=${digest}`);
}

tests {
  test("Changed payload under the same event id returns conflict", function () {
    expect(res.status).to.equal(409);
    expect(res.body.code).to.equal("webhook_payload_conflict");
  });
}
