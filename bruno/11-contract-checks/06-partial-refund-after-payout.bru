meta {
  name: Apply partial refund after payout
  type: http
  seq: 6
}

post {
  url: {{base_url}}/v1/webhooks/commerce/{{brand_slug}}
  body: text
  auth: none
}

headers {
  Content-Type: application/json
}

body:text {
  {}
}

script:pre-request {
  const crypto = require("crypto-js");
  const raw = JSON.stringify({
    event_id: `evt-refund-${bru.getEnvVar("run_id")}`,
    event_type: "order.refunded",
    order_id: bru.getEnvVar("external_order_id"),
    occurred_at: bru.getEnvVar("payout_cutoff_at"),
    amount: "200.00",
    currency: "BRL",
    coupon_code: null,
    click_id: null,
    refunded_amount: "50.00"
  });
  const digest = crypto.HmacSHA256(raw, bru.getEnvVar("webhook_secret")).toString(crypto.enc.Hex);
  req.setBody(raw);
  req.setHeader("X-Webhook-Signature", `sha256=${digest}`);
}

tests {
  test("Post-payout refund creates an append-only negative adjustment", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("partially_refunded");
    expect(res.body.order_id).to.equal(bru.getEnvVar("order_id"));
  });
}
