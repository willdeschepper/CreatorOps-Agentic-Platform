meta {
  name: Cancel the second order
  type: http
  seq: 8
}

post {
  url: {{base_url}}/v1/webhooks/commerce/{{brand_slug}}
  body: text
  auth: none
}

headers {
  Content-Type: application/json
}

body:text {
  {}
}

script:pre-request {
  const crypto = require("crypto-js");
  const raw = JSON.stringify({
    event_id: `evt-cancelled-${bru.getEnvVar("run_id")}`,
    event_type: "order.cancelled",
    order_id: `order-cancel-${bru.getEnvVar("run_id")}`,
    occurred_at: bru.getEnvVar("commerce_occurred_at"),
    amount: "80.00",
    currency: "BRL",
    coupon_code: null,
    click_id: null
  });
  const digest = crypto.HmacSHA256(raw, bru.getEnvVar("webhook_secret")).toString(crypto.enc.Hex);
  req.setBody(raw);
  req.setHeader("X-Webhook-Signature", `sha256=${digest}`);
}

tests {
  test("Unpaid order can be cancelled without creating commission", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("cancelled");
  });
}
