meta {
  name: Register invited creator
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{invite_email}}",
    "password": "{{password}}",
    "display_name": "Invited Creator"
  }
}

script:post-response {
  bru.setEnvVar("creator_invited_id", res.body.id);
}

tests {
  test("Register invited creator: HTTP contract", function () {
    expect(res.status).to.equal(201);
    expect(res.body).to.exist;
  });
}
