meta {
  name: Authenticate invited creator
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/auth/token
  body: json
  auth: none
}

body:json {
  {
    "email": "{{invite_email}}",
    "password": "{{password}}",
    "brand_slug": null
  }
}

script:post-response {
  bru.setEnvVar("invite_creator_token", res.body.access_token);
}

tests {
  test("Authenticate invited creator: HTTP contract", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.exist;
  });
}
