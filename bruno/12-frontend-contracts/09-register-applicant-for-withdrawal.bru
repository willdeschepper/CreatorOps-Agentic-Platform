meta {
  name: Register applicant for withdrawal
  type: http
  seq: 9
}

post {
  url: {{base_url}}/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{withdraw_email}}",
    "password": "{{password}}",
    "display_name": "Withdraw Applicant"
  }
}

tests {
  test("Register applicant for withdrawal: HTTP contract", function () {
    expect(res.status).to.equal(201);
    expect(res.body).to.exist;
  });
}
