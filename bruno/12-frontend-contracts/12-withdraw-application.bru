meta {
  name: Withdraw application
  type: http
  seq: 12
}

post {
  url: {{base_url}}/v1/applications/{{withdraw_application_id}}/withdraw
  body: json
  auth: bearer
}

auth:bearer {
  token: {{withdraw_creator_token}}
}

body:json {
  {
    "comment": "I am withdrawing this application."
  }
}

tests {
  test("Withdraw application: HTTP contract", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.exist;
  });
}
