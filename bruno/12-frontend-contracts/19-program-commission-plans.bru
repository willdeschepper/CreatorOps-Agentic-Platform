meta {
  name: Program commission plans
  type: http
  seq: 19
}

get {
  url: {{base_url}}/v1/programs/{{program_id}}/commission-plans?limit=2&offset=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{finance_token}}
}

tests {
  test("Program commission plans: HTTP contract", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.total).to.be.a("number");
    expect(res.body.limit).to.equal(2);
    expect(res.body.offset).to.equal(0);
  });
}
