meta {
  name: Membership commissions
  type: http
  seq: 27
}

get {
  url: {{base_url}}/v1/memberships/{{membership_a_id}}/commissions?limit=2&offset=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{creator_a_token}}
}

tests {
  test("Membership commissions: HTTP contract", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.total).to.be.a("number");
    expect(res.body.limit).to.equal(2);
    expect(res.body.offset).to.equal(0);
  });
}
