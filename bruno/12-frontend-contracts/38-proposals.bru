meta {
  name: Proposals
  type: http
  seq: 38
}

get {
  url: {{base_url}}/v1/agent/proposals?limit=2&offset=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{finance_token}}
}

tests {
  test("Proposals: HTTP contract", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.total).to.be.a("number");
    expect(res.body.limit).to.equal(2);
    expect(res.body.offset).to.equal(0);
  });
}
