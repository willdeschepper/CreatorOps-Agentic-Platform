  token: {{ops_token}}
}

body:json {
  {
    "status": "removed",
    "comment": "Bruno verifies campaign removal."
  }
}

tests {
  test("Remove campaign participant: HTTP contract", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.exist;
  });
}
